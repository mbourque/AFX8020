BEGIN_ASM_DESCR

IF_1 ELEM_NEW
CONFIG_ELEM
REGEN_MDL THIS
END_IF_1

IF_2 ELEM_EXIST
USER_SELECT AXIS PLACEMENT_AXIS
USER_SELECT FACE PROFILE_SURFACE
END_IF_2


SEARCH_MDL_REF THIS PLANE XY CONNECTOR_XY
SEARCH_MDL_REF THIS PLANE XZ CONNECTOR_XZ
SEARCH_MDL_REF THIS AXIS A_7 CONNECTOR_AXIS

SEARCH_MDL_REF PROFILE_SURFACE PLANE XY PROFILE_XY

ASSEMBLE THIS
ALIGN PROFILE_SURFACE CONNECTOR_XZ
ALIGN PLACEMENT_AXIS CONNECTOR_AXIS
ORIENT PROFILE_XY CONNECTOR_XY
END_ASSEMBLE

FOR_1 PLACE_REF REF OTHER_REFS_IN_FEAT PLACEMENT_AXIS
ASSEMBLE THIS
ALIGN PROFILE_SURFACE CONNECTOR_XZ
ALIGN PLACE_REF CONNECTOR_AXIS
ORIENT PROFILE_XY CONNECTOR_XY
END_ASSEMBLE
END_FOR_1


END_ASM_DESCR



BEGIN_GUI_DECSCR

GLOBAL_PICTURE bolt_nut_tab.gif

USER_SELECT AXIS PLACEMENT_AXIS 1
USER_SELECT FACE PROFILE_SURFACE 2


END_GUI_DESCR


